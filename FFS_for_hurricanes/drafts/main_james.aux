\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Storm-centred physics along a representative reactive pathway for the Earl IC (2022-09-02T00Z, pathway~26), $\lambda _0$ through $\lambda _4$. Each column shows one interface crossing; column headers give the MSLP and storm latitude. The vortex tracks northeastward from 25$^\circ $N at $\lambda _0$ to 39$^\circ $N at $\lambda _4$, consistent with typical late-summer Atlantic tracks in this environment. \textit  {Row 1}: 850-hPa relative vorticity $\zeta _{850}$ ($10^{-5}$~s$^{-1}$). \textit  {Row 2}: 700-hPa relative humidity RH$_{700}$ (\%). \textit  {Row 3}: 500-hPa warm-core anomaly $T'_{500}$ (K, relative to 0--30$^\circ $N mean). The persistent cyclonic vorticity and warm-core anomaly at each interface confirm continuous vortex identity and warm-core structure through state~$B$. Pathways where the warm core collapses at high latitudes are screened out by the CPS filter and not included in the genesis rate calculation.}}{20}{figure.10}\protected@file@percent }
\newlabel{fig:physics}{{10}{20}{Storm-centred physics along a representative reactive pathway for the Earl IC (2022-09-02T00Z, pathway~26), $\lambda _0$ through $\lambda _4$. Each column shows one interface crossing; column headers give the MSLP and storm latitude. The vortex tracks northeastward from 25$^\circ $N at $\lambda _0$ to 39$^\circ $N at $\lambda _4$, consistent with typical late-summer Atlantic tracks in this environment. \textit {Row 1}: 850-hPa relative vorticity $\zeta _{850}$ ($10^{-5}$~s$^{-1}$). \textit {Row 2}: 700-hPa relative humidity RH$_{700}$ (\%). \textit {Row 3}: 500-hPa warm-core anomaly $T'_{500}$ (K, relative to 0--30$^\circ $N mean). The persistent cyclonic vorticity and warm-core anomaly at each interface confirm continuous vortex identity and warm-core structure through state~$B$. Pathways where the warm core collapses at high latitudes are screened out by the CPS filter and not included in the genesis rate calculation}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Storm-centred physics composites along reactive pathways for the Earl IC (2022-09-02T00Z). Columns show interfaces $\lambda _0$ through state~$B$; sample sizes $n$ in each column header. Rows show: (1) 850-hPa relative vorticity $\zeta _{850}$ ($10^{-5}$~s$^{-1}$); (2) 700-hPa relative humidity RH$_{700}$ (\%); (3) 500-hPa warm-core anomaly $T'_{500}$ (K). The weaker vorticity and warm-core organisation at $\lambda _1$ reflects Earl's lower $P_1$ value and identifies initial organisation as the rate-limiting bottleneck.}}{21}{figure.11}\protected@file@percent }
\newlabel{fig:composites_earl}{{11}{21}{Storm-centred physics composites along reactive pathways for the Earl IC (2022-09-02T00Z). Columns show interfaces $\lambda _0$ through state~$B$; sample sizes $n$ in each column header. Rows show: (1) 850-hPa relative vorticity $\zeta _{850}$ ($10^{-5}$~s$^{-1}$); (2) 700-hPa relative humidity RH$_{700}$ (\%); (3) 500-hPa warm-core anomaly $T'_{500}$ (K). The weaker vorticity and warm-core organisation at $\lambda _1$ reflects Earl's lower $P_1$ value and identifies initial organisation as the rate-limiting bottleneck}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces As in Fig.~\ref {fig:composites_earl} but for the Fiona precursor IC (2022-09-09T12Z). Stronger vorticity and warm-core development at early interfaces compared to Earl reflects the more favourable large-scale environment and higher $P_1$.}}{22}{figure.12}\protected@file@percent }
\newlabel{fig:composites_fiona}{{12}{22}{As in Fig.~\ref {fig:composites_earl} but for the Fiona precursor IC (2022-09-09T12Z). Stronger vorticity and warm-core development at early interfaces compared to Earl reflects the more favourable large-scale environment and higher $P_1$}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces As in Fig.~\ref {fig:composites_earl} but for the Ian precursor IC (2022-09-22T00Z). The $T'_{500}$ amplitude at state~$B$ is comparable across all three ICs despite their differing genesis rates, suggesting a physically similar final intensification pathway once the vortex reaches the near-hurricane threshold.}}{23}{figure.13}\protected@file@percent }
\newlabel{fig:composites_ian}{{13}{23}{As in Fig.~\ref {fig:composites_earl} but for the Ian precursor IC (2022-09-22T00Z). The $T'_{500}$ amplitude at state~$B$ is comparable across all three ICs despite their differing genesis rates, suggesting a physically similar final intensification pathway once the vortex reaches the near-hurricane threshold}{figure.13}{}}
