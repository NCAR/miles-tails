\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Flux generation statistics for the three case-study initial conditions. $N_{\text  {traj}}$: total flux-phase trajectories generated. $N_{\text  {cross}}$: decorrelated $\lambda _0$ crossings (target 2000). $T_{\text  {flux}}$: cumulative flux-phase simulation time. $\Phi _{A,0}$: estimated flux with Poisson uncertainty. $N_{\text  {direct}}$: trajectories reaching state~$B$ directly during flux generation (used for direct-sampling rate validation).}}{24}{table.2}\protected@file@percent }
\newlabel{tab:flux_results}{{2}{24}{Flux generation statistics for the three case-study initial conditions. $N_{\text {traj}}$: total flux-phase trajectories generated. $N_{\text {cross}}$: decorrelated $\lambda _0$ crossings (target 2000). $T_{\text {flux}}$: cumulative flux-phase simulation time. $\Phi _{A,0}$: estimated flux with Poisson uncertainty. $N_{\text {direct}}$: trajectories reaching state~$B$ directly during flux generation (used for direct-sampling rate validation)}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Conditional Transition Probabilities}{24}{subsection.5.3}\protected@file@percent }
\newlabel{sec:shooting_results}{{5.3}{24}{Conditional Transition Probabilities}{subsection.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Genesis rate estimates across all 98 initial conditions (August 21 -- October 8, 2022) on a logarithmic scale. Blue circles: FFS $\lambda _0$ flux rate $\Phi _{A,0}$ (crossings day$^{-1}$). Green squares: Full FFS genesis rate $k_{A\to B}^{\text  {FFS}}$ (flux $\times $ product of conditional probabilities). Orange triangles: Direct formation rate $k_{A\to B}^{\text  {direct}}$ from state-$B$ arrivals during flux generation; agreement with FFS rate (mean ratio $1.03\pm 0.15$) validates the method. The FFS rate resolves a clear seasonal cycle spanning nearly three orders of magnitude ($2.6\times 10^{-5}$ to $1.7\times 10^{-2}$ day$^{-1}$) that would be largely unresolvable by direct ensemble sampling for most initial conditions.}}{25}{figure.2}\protected@file@percent }
\newlabel{fig:ffs_rates}{{2}{25}{Genesis rate estimates across all 98 initial conditions (August 21 -- October 8, 2022) on a logarithmic scale. Blue circles: FFS $\lambda _0$ flux rate $\Phi _{A,0}$ (crossings day$^{-1}$). Green squares: Full FFS genesis rate $k_{A\to B}^{\text {FFS}}$ (flux $\times $ product of conditional probabilities). Orange triangles: Direct formation rate $k_{A\to B}^{\text {direct}}$ from state-$B$ arrivals during flux generation; agreement with FFS rate (mean ratio $1.03\pm 0.15$) validates the method. The FFS rate resolves a clear seasonal cycle spanning nearly three orders of magnitude ($2.6\times 10^{-5}$ to $1.7\times 10^{-2}$ day$^{-1}$) that would be largely unresolvable by direct ensemble sampling for most initial conditions}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Conditional transition probabilities $P(\lambda _{i+1}|\lambda _i)$ for the three case-study ICs and all-98-IC aggregate statistics. $N_{\text  {rej}}$ is the number of CPS-rejected (extratropical) trajectories at $\lambda _1$ as a fraction of attempts, reflecting the CPS contamination screen. The product $\DOTSB \prod@ \slimits@ P_i$ is $P(\lambda _4|\lambda _0)$, the probability that a trajectory at $\lambda _0$ reaches state~$B$. Target ensemble: $N_{\text  {shoot}} = 2000$ per interface.}}{25}{table.3}\protected@file@percent }
\newlabel{tab:shooting_results}{{3}{25}{Conditional transition probabilities $P(\lambda _{i+1}|\lambda _i)$ for the three case-study ICs and all-98-IC aggregate statistics. $N_{\text {rej}}$ is the number of CPS-rejected (extratropical) trajectories at $\lambda _1$ as a fraction of attempts, reflecting the CPS contamination screen. The product $\prod P_i$ is $P(\lambda _4|\lambda _0)$, the probability that a trajectory at $\lambda _0$ reaches state~$B$. Target ensemble: $N_{\text {shoot}} = 2000$ per interface}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Temporal evolution of the $\lambda _0$ flux rate and conditional transition probabilities $P(\lambda _{i+1}|\lambda _i)$ for interfaces $\lambda _1$--$\lambda _4$ across all 98 initial conditions (August--October 2022). FFS conditional probabilities vary substantially across the season, especially for $P(\lambda _1|\lambda _0)$ (first shooting interface, reflecting ease of initial organization) and $P(\lambda _4|\lambda _3)$ (last interface before state~$B$, reflecting difficulty of final intensification to 975 hPa). The September 9 peak in $\lambda _1$--$\lambda _3$ probabilities is consistent with the highly favourable genesis environment around Fiona's formation period.}}{26}{figure.3}\protected@file@percent }
\newlabel{fig:ffs_ifs_comparison}{{3}{26}{Temporal evolution of the $\lambda _0$ flux rate and conditional transition probabilities $P(\lambda _{i+1}|\lambda _i)$ for interfaces $\lambda _1$--$\lambda _4$ across all 98 initial conditions (August--October 2022). FFS conditional probabilities vary substantially across the season, especially for $P(\lambda _1|\lambda _0)$ (first shooting interface, reflecting ease of initial organization) and $P(\lambda _4|\lambda _3)$ (last interface before state~$B$, reflecting difficulty of final intensification to 975 hPa). The September 9 peak in $\lambda _1$--$\lambda _3$ probabilities is consistent with the highly favourable genesis environment around Fiona's formation period}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Hurricane genesis committor curve $p_B(\lambda _i)$ — probability of reaching state $B$ ($\leq $975~hPa) given a trajectory at interface $\lambda _i$, for the three case-study ICs (Earl, Sep~9 active, Ian precursor). Lines with shading: FFS estimates with $1\sigma $ propagated binomial uncertainty. The three ICs reveal distinct shapes: Earl has the lowest $p_B$ at $\lambda _1$ (bottleneck at initial organization); Ian precursor has high $p_B$ through $\lambda _2$ then drops sharply (bottleneck at final intensification); Sep~9 active-period IC has the highest committor throughout.}}{27}{figure.4}\protected@file@percent }
\newlabel{fig:committor_curve}{{4}{27}{Hurricane genesis committor curve $p_B(\lambda _i)$ — probability of reaching state $B$ ($\leq $975~hPa) given a trajectory at interface $\lambda _i$, for the three case-study ICs (Earl, Sep~9 active, Ian precursor). Lines with shading: FFS estimates with $1\sigma $ propagated binomial uncertainty. The three ICs reveal distinct shapes: Earl has the lowest $p_B$ at $\lambda _1$ (bottleneck at initial organization); Ian precursor has high $p_B$ through $\lambda _2$ then drops sharply (bottleneck at final intensification); Sep~9 active-period IC has the highest committor throughout}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Case Study: Hurricane Earl (2022)}{28}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Reactive trajectories for the Hurricane Earl initial condition (2022-09-02T00Z), $\sim $24~hours before genesis. \textit  {Left}: Spaghetti plot of FFS-generated reactive tracks (trajectories that ultimately reached state~$B$, i.e., MSLP~$\leq $~975~hPa). Track color indicates interface level; track weight encodes cluster size. \textit  {Right}: 2$^\circ $ crossing-density histogram weighted by transition-flow, with arrows indicating the mean $A{\to }B$ direction at each interface. The ensemble traces a tight recurving corridor northward along the US East Coast before spreading into the western North Atlantic, closely anticipating Earl's observed track.}}{28}{figure.5}\protected@file@percent }
\newlabel{fig:earl_trajectories}{{5}{28}{Reactive trajectories for the Hurricane Earl initial condition (2022-09-02T00Z), $\sim $24~hours before genesis. \textit {Left}: Spaghetti plot of FFS-generated reactive tracks (trajectories that ultimately reached state~$B$, i.e., MSLP~$\leq $~975~hPa). Track color indicates interface level; track weight encodes cluster size. \textit {Right}: 2$^\circ $ crossing-density histogram weighted by transition-flow, with arrows indicating the mean $A{\to }B$ direction at each interface. The ensemble traces a tight recurving corridor northward along the US East Coast before spreading into the western North Atlantic, closely anticipating Earl's observed track}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces FFS shooting tree for the top geographically-spread $\lambda _0$ seed from the Earl IC (2022-09-02T00Z, config 0440\_BN, rank 1 by $\lambda _4$ descendant count after applying a geographic-spread quality filter that excludes seeds whose descendants all cluster within a single grid cell). Points show the MSLP-minimum location at each 6-hour timestep, colored by interface level ($\lambda _0 = 1000$~hPa through state~$B$ at 975~hPa). Branches fan northward from the genesis region, spanning a range of committed recurvature pathways along the US East Coast.}}{29}{figure.6}\protected@file@percent }
\newlabel{fig:earl_tree}{{6}{29}{FFS shooting tree for the top geographically-spread $\lambda _0$ seed from the Earl IC (2022-09-02T00Z, config 0440\_BN, rank 1 by $\lambda _4$ descendant count after applying a geographic-spread quality filter that excludes seeds whose descendants all cluster within a single grid cell). Points show the MSLP-minimum location at each 6-hour timestep, colored by interface level ($\lambda _0 = 1000$~hPa through state~$B$ at 975~hPa). Branches fan northward from the genesis region, spanning a range of committed recurvature pathways along the US East Coast}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Spatial committor field $p_B(\mathbf  {x}|\lambda _i)$ for the Earl IC (2022-09-02T00Z) at each FFS interface. Each panel shows the fraction of configurations whose MSLP minimum falls in a given 2$^\circ $ grid cell that eventually reach state~$B$ ($\leq $975~hPa), for interfaces $\lambda _0$ through $\lambda _4$. At $\lambda _0$ (top left) high-$p_B$ cells span a broad swath of the subtropical Atlantic from the Bahamas to Bermuda. By $\lambda _2$--$\lambda _3$ the committed region contracts into a narrow stripe running from $\sim $25$^\circ $N, 75$^\circ $W northward along the coastline, directly tracing Earl's observed genesis and early-track region. The progressive spatial sharpening quantifies how commitment to genesis localizes as the proto-Earl vortex deepens and becomes dynamically locked to its steering-flow corridor.}}{30}{figure.7}\protected@file@percent }
\newlabel{fig:earl_committor_map}{{7}{30}{Spatial committor field $p_B(\mathbf {x}|\lambda _i)$ for the Earl IC (2022-09-02T00Z) at each FFS interface. Each panel shows the fraction of configurations whose MSLP minimum falls in a given 2$^\circ $ grid cell that eventually reach state~$B$ ($\leq $975~hPa), for interfaces $\lambda _0$ through $\lambda _4$. At $\lambda _0$ (top left) high-$p_B$ cells span a broad swath of the subtropical Atlantic from the Bahamas to Bermuda. By $\lambda _2$--$\lambda _3$ the committed region contracts into a narrow stripe running from $\sim $25$^\circ $N, 75$^\circ $W northward along the coastline, directly tracing Earl's observed genesis and early-track region. The progressive spatial sharpening quantifies how commitment to genesis localizes as the proto-Earl vortex deepens and becomes dynamically locked to its steering-flow corridor}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Storm-centred physics along a representative reactive pathway for the Hurricane Earl IC (2022-09-02T00Z). Each column corresponds to one interface level ($\lambda _0$ through $\lambda _4$), with the MSLP minimum and storm latitude shown in each column header. \textit  {Row 1}: Vertical wind shear VWS$_{200\text  {--}850}$ (m\,s$^{-1}$), shown as an anomaly relative to the domain mean to remove the background subtropical-jet gradient. \textit  {Row 2}: Low-level vorticity $\zeta _{850}$ (10$^{-5}$\,s$^{-1}$) confirming continuous vortex identity across all interface crossings. \textit  {Row 3}: Mid-level relative humidity RH$_{700}$ (\%). \textit  {Row 4}: Upper-tropospheric warm-core anomaly $T'_{500}$ (K) relative to the 0--30$^\circ $N mean, distinguishing tropical from extratropical thermal structure.}}{31}{figure.8}\protected@file@percent }
\newlabel{fig:earl_physics_trajectory}{{8}{31}{Storm-centred physics along a representative reactive pathway for the Hurricane Earl IC (2022-09-02T00Z). Each column corresponds to one interface level ($\lambda _0$ through $\lambda _4$), with the MSLP minimum and storm latitude shown in each column header. \textit {Row 1}: Vertical wind shear VWS$_{200\text {--}850}$ (m\,s$^{-1}$), shown as an anomaly relative to the domain mean to remove the background subtropical-jet gradient. \textit {Row 2}: Low-level vorticity $\zeta _{850}$ (10$^{-5}$\,s$^{-1}$) confirming continuous vortex identity across all interface crossings. \textit {Row 3}: Mid-level relative humidity RH$_{700}$ (\%). \textit {Row 4}: Upper-tropospheric warm-core anomaly $T'_{500}$ (K) relative to the 0--30$^\circ $N mean, distinguishing tropical from extratropical thermal structure}{figure.8}{}}
