#!/bin/bash
#PBS -N ffs_composites
#PBS -A NAML0001
#PBS -q nvgpu
#PBS -l select=1:ncpus=16:ngpus=1:mem=128GB
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /glade/derecho/scratch/schreck/FFS/logs/composites_casper.log

# ============================================================
# PBS job: physics composites for all three case-study ICs.
# Runs plot_physics_composites.py in reactive_only mode
# (only configs along reactive pathways), which is fast enough
# for Casper CPUs.  GPU not required since we load pre-computed
# pkls, not run the neural model.
#
# Submit from any casper login node:
#   qsub submit_composites_casper.pbs
# ============================================================

set -euo pipefail

echo "=== FFS Physics Composites Job ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo ""

# ── Environment ──────────────────────────────────────────────
module purge
source ~/.bashrc 2>/dev/null || true
conda activate credit-casper

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

# ── Paths ─────────────────────────────────────────────────────
APPS=/glade/work/schreck/repos/miles-tails/applications
FFS_SCRATCH=/glade/derecho/scratch/schreck/FFS
FFS_CONFIG_FULL=${FFS_SCRATCH}/ffs_composites.yml
MODEL_CONFIG=${FFS_SCRATCH}/model.yml
RESULTS=${FFS_SCRATCH}/results_mar18
PLOT_DIR=${RESULTS}/plots/physics_composites

mkdir -p ${PLOT_DIR}
mkdir -p /glade/derecho/scratch/schreck/FFS/logs

# ── Write a temporary FFS config that points only at our 3 case-study ICs.
# This avoids running composites for all 98 ICs (would take days).
python - <<'PYEOF'
import yaml, pathlib

src = pathlib.Path('/glade/derecho/scratch/schreck/FFS/ffs.yml')
with open(src) as f:
    cfg = yaml.safe_load(f)

# Override to run only the three case-study ICs
cfg['forecast_start_times'] = [
    '2022-09-02 00:00:00',   # Earl
    '2022-09-09 12:00:00',   # Active / Fiona environment
    '2022-09-22 00:00:00',   # Ian precursor
]

out = pathlib.Path('/glade/derecho/scratch/schreck/FFS/ffs_composites.yml')
with open(out, 'w') as f:
    yaml.dump(cfg, f, default_flow_style=False)

print(f"Wrote {out} with {len(cfg['forecast_start_times'])} ICs")
PYEOF

echo ""
echo "=== Running plot_physics_composites.py ==="
echo "  ICs: Earl (09-02), Active (09-09), Ian pre (09-22)"
echo "  Mode: reactive_only (ancestors of state-B configs only)"
echo "  Workers: 16"
echo "  Output: ${PLOT_DIR}"
echo ""

cd ${FFS_SCRATCH}

python ${APPS}/plot_physics_composites.py \
    --model_config  ${MODEL_CONFIG} \
    --ffs_config    ${FFS_CONFIG_FULL} \
    --output_dir    ${RESULTS}/physics_cache \
    --plot_dir      ${PLOT_DIR} \
    --workers       16 \
    --box_deg       12 \
    --reactive_only

echo ""
echo "=== Done. Plots in: ${PLOT_DIR} ==="
ls -la ${PLOT_DIR}/*.png 2>/dev/null | wc -l && echo "PNGs generated" || echo "WARNING: no PNGs found"
