#!/bin/bash
#PBS -N ffs_traj_phys
#PBS -A NAML0001
#PBS -q nvgpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /glade/derecho/scratch/schreck/FFS/logs/trajectory_physics.log

# ============================================================
# PBS job: trajectory physics plots for 3 case-study ICs.
# Requires GPU to run neural model along pathway configs.
#
# Submit: qsub submit_trajectory_physics.pbs
# ============================================================

set -euo pipefail

echo "=== Trajectory Physics Job ==="
echo "Date: $(date)"

source ~/.bashrc 2>/dev/null || true
conda activate credit-casper

export PYTHONPATH=/glade/work/schreck/repos/miles-credit-main:${PYTHONPATH:-}
export PYTHONPATH=/glade/work/schreck/repos/miles-tails:${PYTHONPATH}
export OMP_NUM_THREADS=1

APPS=/glade/work/schreck/repos/miles-tails/applications
FFS_SCRATCH=/glade/derecho/scratch/schreck/FFS
MODEL_CONFIG=${FFS_SCRATCH}/model.yml
FFS_CONFIG=${FFS_SCRATCH}/ffs.yml
RESULTS=${FFS_SCRATCH}/results_mar18
PLOT_DIR=${RESULTS}/plots/trajectory_physics

mkdir -p ${PLOT_DIR}

cd ${FFS_SCRATCH}

# Earl: pathways 0,1,9,21,22,24,26 already exist — add a few more (top 10)
for IC_TIME in "2022-09-02 00:00:00" "2022-09-09 12:00:00" "2022-09-22 00:00:00"; do
    IC_LABEL="${IC_TIME:0:10}T${IC_TIME:11:2}Z"
    echo ""
    echo "=== ${IC_LABEL} — listing available pathways ==="
    python ${APPS}/plot_trajectory_physics.py \
        --model_config ${MODEL_CONFIG} \
        --ffs_config   ${FFS_CONFIG} \
        --ic_time      "${IC_TIME}" \
        --list_pathways \
        --plot_dir     ${PLOT_DIR}
done

echo ""
echo "=== Generating pathway plots (top 5 per IC) ==="

# Plot pathways 0-4 for each IC (adjust pathway_idx as needed after listing)
for IC_TIME in "2022-09-02 00:00:00" "2022-09-09 12:00:00" "2022-09-22 00:00:00"; do
    IC_LABEL="${IC_TIME:0:10}T${IC_TIME:11:2}Z"
    echo ""
    echo "=== ${IC_LABEL} ==="
    for IDX in 0 1 2 3 4; do
        echo "  pathway ${IDX}"
        python ${APPS}/plot_trajectory_physics.py \
            --model_config ${MODEL_CONFIG} \
            --ffs_config   ${FFS_CONFIG} \
            --ic_time      "${IC_TIME}" \
            --pathway_idx  ${IDX} \
            --plot_dir     ${PLOT_DIR} || echo "  WARNING: pathway ${IDX} failed, continuing"
    done
done

echo ""
echo "=== Done. Output in: ${PLOT_DIR} ==="
ls -la ${PLOT_DIR}/*.png 2>/dev/null | wc -l && echo "PNGs"
